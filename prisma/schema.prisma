datasource db {
  provider = "mongodb"
  url      = env("MONGODB_URI")
}

generator client {
  provider = "prisma-client"
  binaryTargets = ["native", "debian-openssl-3.0.x", "rhel-openssl-3.0.x"]
  output   = "../generated/prisma"
}

model User {
  id            String          @id @default(auto()) @map("_id") @db.ObjectId
  name          String?
  email         String?         @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]

  // Onboarding Data
  age           Int?
  gender        String?
  weight        Float?
  height        Float?
  fitnessLevel  String?
  equipment     String?
  schedule      String?
  limitations   String?
  target        String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  weeklyPlans   WeeklyPlan[]
  activities    ExerciseActivity[]
}

model Account {
  id                String  @id @default(auto()) @map("_id") @db.ObjectId
  userId            String  @db.ObjectId
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.String
  access_token      String? @db.String
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.String
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionToken String   @unique
  userId       String   @db.ObjectId
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WeeklyPlan {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  userId          String    @db.ObjectId
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  ptSummary       String?
  planDescription String?
  startDate       DateTime  @default(now())
  endDate         DateTime?
  isActive        Boolean   @default(true)

  days            DayPlan[]

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model DayPlan {
  id              String            @id @default(auto()) @map("_id") @db.ObjectId
  weeklyPlanId    String            @db.ObjectId
  weeklyPlan      WeeklyPlan        @relation(fields: [weeklyPlanId], references: [id], onDelete: Cascade)

  dayName         String            // e.g., "Day 1", "Monday"
  title           String            // e.g., "Push Day"
  estimatedTime   String?
  order           Int               // 1-7

  exercises       PlannedExercise[]
}

model PlannedExercise {
  id              String            @id @default(auto()) @map("_id") @db.ObjectId
  dayPlanId       String            @db.ObjectId
  dayPlan         DayPlan           @relation(fields: [dayPlanId], references: [id], onDelete: Cascade)

  name            String
  sets            String?
  reps            String?
  notes           String?
  order           Int

  activities      ExerciseActivity[]
}

model ExerciseActivity {
  id                String          @id @default(auto()) @map("_id") @db.ObjectId
  userId            String          @db.ObjectId
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  plannedExerciseId String          @db.ObjectId
  plannedExercise   PlannedExercise @relation(fields: [plannedExerciseId], references: [id], onDelete: Cascade)

  status            ActivityStatus  @default(PENDING)
  startedAt         DateTime?
  completedAt       DateTime?

  // Optional: Track actual performance
  actualSets        Int?
  actualReps        Int?

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

enum ActivityStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  SKIPPED
}
